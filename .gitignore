sberp/target/
.metadata/
.vscode/
Servers/

# 환경별 비밀 설정 (예시 파일만 Git 에 포함)
sberp/.env
sberp/config/erp.properties
sberp/src/main/resources/egovframework/env/erp-local.properties

# docs/docker 자료 — 문서·설정 예시만 Git 에 올리고 비밀 값은 제외
# (dev/.env, pro/erp/.env 에 DB·Nextcloud 실제 비밀번호가 들어 있다)
sberp/docs/docker/**/.env
sberp/docs/docker/**/erp.properties
sberp/docs/docker/**/*.key
sberp/docs/docker/**/*.crt
sberp/docs/docker/**/*.pem
#
# 주의: 아래 두 파일은 무시 대상이 아니지만 비밀번호가 하드코딩돼 있다.
#   docs/docker/pro/erp/docker-compose.yml   MYSQL_ROOT_PASSWORD
#   docs/docker/pro/file/docker-compose.yml  MYSQL_ROOT_PASSWORD, MYSQL_PASSWORD, MINIO_ROOT_PASSWORD
# 커밋 전에 ${VAR} 로 바꾸고 값은 .env 로 옮길 것.

# 로그·빌드 부산물
sberp/logs/
*.log
__pycache__/
*.pyc

# Eclipse 개인 설정 (새로 생기는 것만 — 기존 .settings 파일은 계속 추적)
sberp/.factorypath
sberp/.pydevproject
sberp/.settings/org.eclipse.jdt.apt.core.prefs
sberp/.settings/org.eclipse.m2e.core.prefs

# OS
Thumbs.db
