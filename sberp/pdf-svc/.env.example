# pdf-svc 환경변수 예시. 실제 값은 .env 로 복사하거나 docker-compose 에서 주입.

# Java(Tomcat) -> pdf-svc 컨테이너 간 인증 공유 시크릿 (로컬 테스트는 비워도 됨)
PDF_INTERNAL_TOKEN=

# HTML 로드·렌더 타임아웃(ms). 성적서·이미지 많을 때 120000~180000
PDF_DEFAULT_TIMEOUT_MS=120000

# export HTML 의 http://localhost:8080 → Docker 에서 Tomcat (호스트) 접근
# 폰트·CSS: ERP webapp /report/common/css/report_fonts.css HTTP fetch
PDF_ERP_HOST=host.docker.internal
PDF_ERP_PORT=8080
